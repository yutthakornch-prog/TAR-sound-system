<Window x:Class="TAR.SoundSystem.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TAR Sound System M2" Width="1380" Height="860" Background="#0B1220" Foreground="White"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock FontSize="28" FontWeight="Bold" Text="TAR SOUND SYSTEM • MILESTONE 2"/><Border Grid.Row="1" Background="#111A2C" Padding="12" Margin="0,12"><DockPanel><ComboBox x:Name="MidiCombo" Width="210" Margin="4"/><ComboBox x:Name="AudioCombo" Width="250" Margin="4" DisplayMemberPath="Name"/><TextBox x:Name="SoundFontPath" Width="360" Margin="4" IsReadOnly="True"/><Button Content="เลือก SF2" Click="BrowseSoundFont_Click" Margin="4"/><Button Content="เริ่ม LIVE" Click="Start_Click" Margin="4"/><Button Content="หยุด" Click="Stop_Click" Margin="4"/><Button Content="PANIC" Click="Panic_Click" Margin="4" Background="#DC2626"/><Button Content="เพิ่ม VST3" Click="AddVst_Click" Margin="4" Background="#7C3AED"/><TextBlock x:Name="StatusText" Margin="16,8" Text="พร้อม"/></DockPanel></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><DataGrid x:Name="ChannelGrid" AutoGenerateColumns="False" CanUserAddRows="False" Foreground="#111827"><DataGrid.Columns><DataGridTextColumn Header="CH" Binding="{Binding Channel}" IsReadOnly="True"/><DataGridTextColumn Header="Part" Binding="{Binding Name}" IsReadOnly="True"/><DataGridTextColumn Header="Volume" Binding="{Binding Volume,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Pan" Binding="{Binding Pan,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Program" Binding="{Binding Program,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Transpose" Binding="{Binding Transpose,UpdateSourceTrigger=PropertyChanged}"/><DataGridCheckBoxColumn Header="Mute" Binding="{Binding Mute,UpdateSourceTrigger=PropertyChanged}"/><DataGridCheckBoxColumn Header="Solo" Binding="{Binding Solo,UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" Background="#111A2C" Padding="18" Margin="12,0,0,0"><StackPanel><TextBlock FontSize="20" Text="Mastering + Registration"/><TextBlock Text="Low"/><Slider x:Name="LowSlider" Minimum="-12" Maximum="12" ValueChanged="EqChanged"/><TextBlock Text="Mid"/><Slider x:Name="MidSlider" Minimum="-12" Maximum="12" ValueChanged="EqChanged"/><TextBlock Text="High"/><Slider x:Name="HighSlider" Minimum="-12" Maximum="12" ValueChanged="EqChanged"/><TextBlock Text="Master"/><Slider x:Name="MasterSlider" Minimum="-30" Maximum="6" Value="-6" ValueChanged="MasterChanged"/><TextBlock Text="Peak"/><ProgressBar x:Name="PeakMeter" Height="24" Maximum="1"/><Separator Margin="0,10"/><CheckBox x:Name="CompEnabled" Content="Compressor Enabled" IsChecked="True" Checked="CompressorChanged" Unchecked="CompressorChanged"/><TextBlock Text="Threshold dB"/><Slider x:Name="ThresholdSlider" Minimum="-48" Maximum="0" Value="-18" ValueChanged="CompressorChanged"/><TextBlock Text="Ratio"/><Slider x:Name="RatioSlider" Minimum="1" Maximum="20" Value="4" ValueChanged="CompressorChanged"/><TextBlock Text="Attack ms"/><Slider x:Name="AttackSlider" Minimum="1" Maximum="200" Value="10" ValueChanged="CompressorChanged"/><TextBlock Text="Release ms"/><Slider x:Name="ReleaseSlider" Minimum="20" Maximum="1000" Value="120" ValueChanged="CompressorChanged"/><TextBlock Text="Makeup dB"/><Slider x:Name="MakeupSlider" Minimum="0" Maximum="18" Value="3" ValueChanged="CompressorChanged"/><TextBlock x:Name="CompressionReadout" Foreground="#FBBF24"/><Separator Margin="0,10"/><TextBlock x:Name="LufsReadout" FontSize="18" FontWeight="Bold" Text="M: -70 LUFS | I: -70 LUFS"/><Button Content="Reset LUFS" Click="ResetLufs_Click" Margin="3"/><TextBlock Text="VST3 Chain" Margin="0,8,0,0"/><ListBox x:Name="VstList" Height="70" Foreground="#111827"/><TextBlock x:Name="MidiMonitor" Margin="0,14" Foreground="#5EEAD4" FontFamily="Consolas"/><Button Content="บันทึก Registration" Click="Save_Click" Margin="3"/><Button Content="เปิด Registration" Click="Load_Click" Margin="3"/></StackPanel></Border></Grid></Grid></Window>